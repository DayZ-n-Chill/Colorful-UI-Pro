// Laid over an item's icon while Ctrl is held on it: the sort cover's spinning arrow, alone, centred.
// HoverSpinner sizes the arrow to the cell and turns it once per hover transfer.
FrameWidgetClass HoverSpinner {
 ignorepointer 1
 position 0 0
 size 1 1
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 priority 1000
 {
  ImageWidgetClass HoverSpin {
   ignorepointer 1
   position 0 0
   size 28 28
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   priority 2
   image0 "set:InventoryIcons image:ArrowsClockwise"
   color 0.8627 0.851 0.8118 1
   mode blend
   "src alpha" 1
   stretch 1
  }
 }
}
