// Rounded top corners only (round_fill_top): an open card reads as one rounded shape with its body,
// which is rounded on the bottom corners only. The flat colour is Deluxe's header colour
// (Deluxe's header black at 80%), because a round_* style needs a PanelWidget.
// A folded card is only this bar, so it is rounded on all four corners: FoldBack takes the
// bar's colour and the bar goes clear (FoldHooks.c).
WrapSpacerWidgetClass closable_header_root {
 clipchildren 0
 ignorepointer 0
 position 0 0
 size 1 48
 halign center_ref
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 1
 userID -1
 draggable 1
 scriptclass ""
 style Empty
 Padding 0
 Margin 0
 "Size To Content V" 1
 content_halign center
 {
  PanelWidgetClass PanelWidget {
   clipchildren 1
   ignorepointer 1
   position 0 0
   size 1 55
   halign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 1
   priority 8
   scriptclass ""
   color 0 0 0 0.8
   style round_fill_top
   {
    PanelWidgetClass FoldBack {
     visible 0
     ignorepointer 1
     position 0 0
     size 1 1
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     color 0 0 0 0.8
     style round_fill
    }
    // The item icon, a fixed 30 px square: DayZ Deluxe's icon is the bar's height, and its bar is its
    // 20 px title plus vanilla's 10 px (ClosableHeader.SetName), so ours no longer grows with our
    // taller title.
    FrameWidgetClass LeftSpacer {
     ignorepointer 1
     position 10 0
     size 30 30
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     fixaspect inside
     {
      PanelWidgetClass MovePanel {
       visible 0
       ignorepointer 1
       color 0 0 0 0.7843
       size 1 1
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 0
       fixaspect fixwidth
       priority 200
       style rover_sim_colorable
       {
        ButtonWidgetClass MoveUp {
         visible 1
         ignorepointer 0
         position 0 0
         size 1 0.5
         halign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 0
         vexactsize 0
         style Empty
         {
          ImageWidgetClass LTArrow {
           ignorepointer 1
           color 0.8 0.8 0.8 1
           size 0.3 0.24
           halign center_ref
           hexactpos 1
           vexactpos 1
           hexactsize 0
           vexactsize 0
           fixaspect inside
           image0 "set:dayz_gui image:icon_plus"
           mode blend
           "src alpha" 1
           "flip v" 1
          }
         }
        }
        ButtonWidgetClass MoveDown {
         visible 1
         ignorepointer 0
         position 0 0
         size 1 0.5
         halign center_ref
         valign bottom_ref
         hexactpos 1
         vexactpos 1
         hexactsize 0
         vexactsize 0
         style Empty
         {
          ImageWidgetClass RTArrow {
           ignorepointer 1
           color 0.8 0.8 0.8 1
           size 0.3 0.24
           halign center_ref
           valign bottom_ref
           hexactpos 1
           vexactpos 1
           hexactsize 0
           vexactsize 0
           fixaspect inside
           image0 "set:dayz_gui image:icon_plus"
           mode blend
           "src alpha" 1
          }
         }
        }
       }
      }
      ItemPreviewWidgetClass Render {
       clipchildren 1
       ignorepointer 1
       color 0.702 0.702 0.702 1
       size 1 1
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 0
       fixaspect fixwidth
       priority 150
       draggable 0
       "force flip enable" 1
      }
     }
    }
    // Starts 8 px right of the icon (10 + 30 + 8), as on DayZ Deluxe.
    RichTextWidgetClass TextWidget0 {
     clipchildren 0
     ignorepointer 1
     position 48 -2
     size 0.9 36
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     style DayZNormal
     text "CLOSABLE HEADER"
     font "Colorful-UI/GUI/fonts/GB-Regular"
     "exact text" 0
     "exact text size" 24
     "size to text h" 0
     "size to text v" 1
     "text valign" center
     wrap 1
    }
    PanelWidgetClass Dropzone {
     ignorepointer 1
     position 0 0
     size 1 1
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     style blank
    }
    GridSpacerWidgetClass RightSpacer {
     ignorepointer 1
     position 10 0
     size 1 1
     halign right_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     fixaspect inside
     Padding 0
     Margin 0
     "Size To Content H" 1
     "Size To Content V" 1
     content_halign right
     content_valign center
     Columns 2
     Rows 1
     {
      ImageWidgetClass electricity {
       visible 0
       clipchildren 0
       ignorepointer 1
       color 0.6235 0.6235 0.6235 1
       position 0 0
       size 29 29
       halign right_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       draggable 0
       image0 "set:dayz_gui image:battery"
       mode additive
       "src alpha" 1
       "clamp mode" clamp
       "stretch mode" stretch_w_h
       {
        ImageWidgetClass electricity_can_work {
         visible 0
         clipchildren 0
         ignorepointer 1
         color 0.9569 0.898 0.1451 1
         size 1 1
         halign center_ref
         valign center_ref
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         priority 500
         image0 "set:dayz_gui image:battery"
         mode blend
         "src alpha" 1
         "clamp mode" clamp
         "stretch mode" stretch_w_h
        }
       }
      }
      // The card's X, Deluxe's close button: a 29 px blank hit box, the same box every header button
      // uses, with InventoryIcons X centred inside at 18 px in Deluxe's text colour (#dcd9cf). Its hover
      // (rounded brand wash, brand glyph, "Close" tip) is HeaderHover (FoldHooks.c).
      PanelWidgetClass collapse_button {
       visible 1
       clipchildren 0
       position 0 0
       size 29 29
       halign right_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       priority 500
       style blank
       {
        ImageWidgetClass close_icon {
         ignorepointer 1
         color 0.8627 0.851 0.8118 1
         position 0 0
         size 18 18
         halign center_ref
         valign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         priority 2
         image0 "set:InventoryIcons image:X"
         mode blend
         "src alpha" 1
         stretch 1
        }
       }
      }
     }
    }
   }
  }
  ItemPreviewWidgetClass Drag_Render {
   visible 0
   clipchildren 1
   ignorepointer 1
   position 0 0
   size 0 0
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   draggable 0
   {
    ImageWidgetClass Color {
     clipchildren 0
     ignorepointer 1
     color 1 1 1 0.0392
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     mode additive
     "src alpha" 1
    }
    PanelWidgetClass Cursor {
     visible 1
     clipchildren 0
     ignorepointer 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     priority 999
     draggable 0
     style Outline
    }
   }
  }
 }
}