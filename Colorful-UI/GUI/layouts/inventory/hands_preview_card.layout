// Rounded bottom corners only (round_fill_bottom): the hands slot is the bottom of the HANDS card's
// preview, under a header rounded on the top corners only. Otherwise a copy of vanilla
// gui/layouts/inventory_new/hands_preview.layout (what the screen draws today), colours unchanged.
PanelWidgetClass hands_preview_root {
 clipchildren 0
 ignorepointer 1
 color 0.3137 0.3137 0.3137 0.651
 size 1 180
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 1
 draggable 0
 scriptclass ""
 style rover_sim_colorable
 "no focus" 0
 style round_fill_bottom
}